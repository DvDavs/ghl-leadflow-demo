# =============================================================================
# .env.example — variable NAMES only.
#
# WARNING: NEVER put real values in this file. It is committed to a PUBLIC
# repository. Copy it to `.env` (gitignored) and fill real values there.
#
# A secret pasted here is a published secret, immediately and irreversibly.
# GitHub's public event stream is scraped continuously, so deleting the commit
# does not undo it — rotate the credential instead.
#
# This working copy also sits inside a cloud-synced folder, so a real `.env`
# here is uploaded to cloud storage even though git ignores it. Keep real
# secrets outside the synced tree, or in the n8n credential store.
#
# No value below is real. Every placeholder is obviously fictional on purpose.
# =============================================================================

# --- GoHighLevel ------------------------------------------------------------
# Sub-account (location) identifier for the demo location.
# Example shape only, NOT a real id: loc_XXXXXXXXXXXXXXXXXXXX
GHL_LOCATION_ID=

# Private Integration token for the demo location.
# Created in the GHL UI under Settings > Private Integrations. Shown once.
# Select the minimum scopes the demo needs. Never reuse an agency-level token.
# Example shape only, NOT a real token: pit-0000000-0000-0000-0000-000000000000
GHL_PRIVATE_INTEGRATION_TOKEN=

# --- n8n --------------------------------------------------------------------
# Base URL of the n8n instance. Self-hosted default is http://localhost:5678
N8N_BASE_URL=

# Public URL of the inbound webhook GoHighLevel will call.
# Use the PRODUCTION webhook URL of a saved and published workflow. The test
# URL expires after 120 seconds and will die mid-demo.
# When tunneling a local instance this value rotates on every tunnel restart —
# re-check it, and re-paste it into the GHL workflow, before any live demo.
N8N_WEBHOOK_URL=

# Shared secret proving an inbound webhook really came from the expected
# sender. Generate a random value; never reuse a token from above.
# Note: GHL's free outbound webhook action sends no signature, so this is
# carried in the payload or the path rather than verified cryptographically.
N8N_WEBHOOK_SECRET=

# --- Google -----------------------------------------------------------------
# Spreadsheet ID of the backup sheet — the segment of the sheet URL between
# /d/ and /edit.
GOOGLE_SHEET_ID=
