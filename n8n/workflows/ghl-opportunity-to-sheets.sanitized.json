      "id": "ledger-lookup",
      "name": "Ledger: Look Up Event",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [660, 260],
      "alwaysOutputData": true,
      "notes": "Always Output Data is ON deliberately: a miss must still emit an item, otherwise the whole new-event branch silently stops."
    },
    {
      "parameters": {
        "jsCode": "// Merge the ledger lookup back onto the normalized delivery.\n//\n// The Data Table node emits the ledger row, not our payload, so the\n// normalized fields are pulled back by node reference rather than threaded\n// through the item.\n\nconst norm = $('Normalize and Authorize').first().json;\n\n// With Always Output Data on, a miss produces one empty-ish item. Only a row\n// that actually carries our eventId counts as a hit.\nconst existing = $input.all()\n  .map((i) => i.json)\n  .find((r) => r && r.eventId === norm.eventId) ?? null;\n\nconst prevAttempt = Number(existing?.attempt);\n\nreturn [{\n  json: {\n    ...norm,\n    ledgerFound: existing !== null,\n    ledgerStatus: existing?.status ?? '',\n\n    // Only 'completed' short-circuits. A stale 'claimed' -- a delivery that\n    // died between the backup write and the ledger update -- deliberately\n    // proceeds, because the leads_backup write is keyed on eventId and is\n    // therefore safe to repeat. See ADR-002 'the race window, honestly'.\n    alreadyProcessed: existing?.status === 'completed',\n\n    attempt: (Number.isFinite(prevAttempt) ? prevAttempt : 0) + 1,\n    firstSeenAt: existing?.firstSeenAt || norm.timestamp\n  }\n}];\n"
      },
