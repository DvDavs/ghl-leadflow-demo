      "id": "webhook-ingress",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-220, 380],
      "webhookId": "REPLACE_WITH_UNGUESSABLE_PATH"
    },
    {
      "parameters": {
        "jsCode": "// Allowlist normalization, secret comparison, and identity minting for one\n// GoHighLevel outbound-webhook delivery.\n//\n// This node performs no writes and must never throw. A malformed or hostile\n// body has to reach the 401 / 422 branches, not crash the execution into a\n// 500 that GHL would then retry.\n\nconst body = $input.first().json.body ?? {};\n\nconst str = (v) => (v === undefined || v === null) ? '' : String(v).trim();\n\n// GHL's free Outbound Webhook action supports no custom headers and no\n// signature, so the shared secret travels in the body. It is compared here,\n// before any write of any kind.\nconst expected = str($vars.GHL_WEBHOOK_SHARED_SECRET);\nconst provided = str(body.sharedSecret);\n\n// Fail closed: an unset variable must never authorize a request.\nconst secretConfigured = expected.length > 0;\nconst authorized = secretConfigured && provided === expected;\n\nconst opportunityId = str(body.opportunityId);\nconst contactId = str(body.contactId);\nconst email = str(body.email);\n\n// opportunityId is required twice over: for the backup row, and because the\n// entire delivery identity is derived from it.\nconst required = { opportunityId, contactId, email };\nconst missing = Object.keys(required).filter((k) => required[k] === '');\n\nreturn [{\n  json: {\n    authorized,\n\n    // Distinguishes 'the n8n variable is missing or misnamed' from 'the two\n    // secrets simply differ'. Both produce a 401, and without this they are\n    // indistinguishable from outside. Reports only whether the variable\n    // resolved -- never its value, and never its length.\n    secretConfigured,\n\n    valid: missing.length === 0,\n    missingFields: missing.join(','),\n\n    // Stable per event. Derived, never sent by GHL. Consistent with ADR-002,\n    // this exists only once GHL has already created the Opportunity, so it\n    // dedupes deliveries and must never gate whether the Opportunity is made.\n    eventId: opportunityId ? ('ghl:opportunity-created:' + opportunityId) : '',\n\n    // New per delivery. A redelivery is a new execution, so this changes --\n    // which is exactly what makes a duplicate legible in run_log.\n    correlationId: 'n8n:' + $execution.id,\n\n    timestamp: new Date().toISOString(),\n\n    contactId,\n    opportunityId,\n    name: str(body.name),\n    email,\n    phone: str(body.phone),\n    business: str(body.business),\n    service: str(body.service),\n    source: str(body.source),\n    stage: str(body.stage),\n    appointment: '',\n    lastAction: 'webhook_received'\n  }\n}];\n"
      },
