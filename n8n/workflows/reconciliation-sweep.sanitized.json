    {
      "id": "8aef86ef-62b2-4629-ad01-bee4fecce988",
      "name": "Missing From Ledger?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        192
      ],
      "parameters": {
        "jsCode": "// An opportunity needs recovery only if the ledger has never seen it.\n//\n// A row in ANY state means the webhook did arrive. 'completed' is done, and\n// 'claimed', 'retry_scheduled' and 'failed' all belong to the retry loop,\n// which owns them. The sweep must never race the retry loop for one event.\n//\n// This is also what makes the sweep safe to run twice: the first run writes\n// a completed ledger row, and every run after that sees it and skips.\nconst candidate = $('One Candidate At A Time').first().json;\n\nconst existing = $input.all()\n  .map((i) => i.json)\n  .find((r) => r && r.eventId === candidate.eventId) ?? null;\n\nreturn [{\n  json: {\n    ...candidate,\n    ledgerFound: existing !== null,\n    ledgerStatus: existing?.status ?? '',\n    needsRecovery: existing === null\n  },\n  pairedItem: { item: 0 }\n}];\n"
      }
    },
    {
      "id": "cfa34fee-e969-491b-87bd-040d893aecf8",
      "name": "Needs Recovery?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1344,
        192
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-needs-recovery",
              "leftValue": "={{ $json.needsRecovery }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
